{
  "id": "flash-next-tp8-256k-autoround",
  "name": "Flash Next · TP8 · QSA · FP8 KV · 无MTP · 256K · AutoRound W4A16",
  "format": "custom",
  "power": {
    "mode": "pstate",
    "idleSeconds": 120,
    "util": 5,
    "confirm": 60,
    "low": 8,
    "high": 16,
    "poll": 5,
    "gpus": "0,1,2,3,4,5,6,7"
  },
  "env": {
    "VLLM_USE_MODELSCOPE": "false",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "NCCL_DEBUG": "WARN",
    "NCCL_IB_DISABLE": "1",
    "NCCL_P2P_DISABLE": "0",
    "OMP_NUM_THREADS": "1",
    "VLLM_SM75_QWEN38_HC_GEMV": "0",
    "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE": "134217728",
    "VLLM_USE_BREAKABLE_CUDAGRAPH": "1",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_SPARSE_INDEXER_MAX_LOGITS_MB": "16",
    "VLLM_SM75_QSA_FLASHINFER_PREFILL": "1",
    "VLLM_SM75_QSA_SHARED_TARGET_SCRATCH": "1",
    "VLLM_SM75_QSA_FP8_MAIN_KV": "1",
    "VLLM_SM75_QSA_CUBLAS_INDEXER": "1",
    "VLLM_SM75_QSA_SELECTED_PAGES_PREFILL": "1",
    "VLLM_ENFORCE_STRICT_TOOL_CALLING": "1",
    "VLLM_SM75_QSA_MIXED_PREFILL": "1",
    "VLLM_SM75_NEXT_MIXED_TOKEN_BUDGET": "0",
    "VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC": "1"
  },
  "args": [
    "${MODEL}",
    "--served-model-name",
    "Qwen3.8-Flash-Next-W4A16-AutoRound",
    "--dtype",
    "float16",
    "--hf-overrides",
    {
      "dtype": "float16"
    },
    "--tensor-parallel-size",
    "8",
    "--enable-expert-parallel",
    "--enable-ep-weight-filter",
    "--language-model-only",
    "--max-model-len",
    "262144",
    "--max-num-seqs",
    "4",
    "--max-num-batched-tokens",
    "4096",
    "--limit-mm-per-prompt",
    {
      "image": 16,
      "video": 0
    },
    "--gpu-memory-utilization",
    "0.92",
    "--kv-cache-dtype",
    "fp8_e4m3",
    "--kv-cache-memory-bytes",
    "2415919104",
    "--enable-prefix-caching",
    "--engram-config",
    {
      "cpu_offload": true
    },
    "--gdn-prefill-backend",
    "flashqla_sm75",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--generation-config",
    "vllm",
    "--enable-prompt-tokens-details",
    "--compilation-config",
    {
      "mode": 0,
      "cudagraph_mode": "PIECEWISE",
      "cudagraph_capture_sizes": [
        1,
        2,
        4
      ]
    },
    "--block-size",
    "16",
    "--scheduler-cls",
    "vllm.v1.core.sched.scheduler_sm75.SM75Scheduler",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--chat-template",
    "/opt/vllm-sm75/templates/qwen38-next-high-compat.jinja",
    "--auto-sleep-idle-timeout",
    "0"
  ],
  "modelFamily": "qwen4_exp",
  "defaultModel": "/models/Qwen3.8-Flash-Next-W4A16-AutoRound"
}
