{
  "id": "flash-next-tp4-32k-ssd",
  "status": "experimental, GPU-unqualified",
  "container_memory_bytes": 6442450944,
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "OMP_NUM_THREADS": "1",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_SM75_QWEN38_HC_GEMV": "0",
    "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE": "67108864",
    "VLLM_SPARSE_INDEXER_MAX_LOGITS_MB": "16",
    "VLLM_SM75_QSA_FLASHINFER_PREFILL": "1",
    "VLLM_SM75_QSA_SHARED_TARGET_SCRATCH": "1",
    "VLLM_SM75_QSA_FP8_MAIN_KV": "1",
    "VLLM_SM75_QSA_CUBLAS_INDEXER": "1",
    "VLLM_SM75_QSA_SELECTED_PAGES_PREFILL": "1",
    "VLLM_SM75_QSA_MIXED_PREFILL": "1",
    "VLLM_SM75_NEXT_MIXED_TOKEN_BUDGET": "0",
    "VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC": "0",
    "NCCL_P2P_DISABLE": "0",
    "NCCL_IB_DISABLE": "1",
    "NCCL_DEBUG": "WARN",
    "Q38_PLE_SSD": "1",
    "Q38_PLE_CACHE_BYTES": "33554432"
  },
  "args": [
    "${MODEL}", "--served-model-name", "Qwen3.8-Flash-Next-4T10-SSD",
    "--dtype", "float16", "--hf-overrides", {"dtype": "float16"},
    "--tensor-parallel-size", "4", "--enable-expert-parallel", "--enable-ep-weight-filter",
    "--language-model-only", "--max-model-len", "32768", "--max-num-seqs", "1",
    "--max-num-batched-tokens", "512", "--enable-chunked-prefill",
    "--gpu-memory-utilization", "0.92", "--kv-cache-dtype", "fp8_e4m3",
    "--kv-cache-memory-bytes", "536870912", "--enable-prefix-caching",
    "--engram-config", {"cpu_offload": false},
    "--load-format", "safetensors", "--safetensors-load-strategy", "lazy",
    "--model-loader-extra-config", {"enable_multithread_load": false},
    "--gdn-prefill-backend", "flashqla_sm75", "--enforce-eager", "--disable-custom-all-reduce",
    "--block-size", "16", "--scheduler-cls", "vllm.v1.core.sched.scheduler_sm75.SM75Scheduler",
    "--generation-config", "vllm", "--host", "0.0.0.0", "--port", "8000"
  ]
}
