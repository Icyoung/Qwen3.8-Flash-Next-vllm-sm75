# Dockerfile.pcieipc-v1 —— T11a：把 FlashInfer 0.7.0.post1 的 PCIe-IPC allreduce 回填进 0.6.18
#
# 单独一层、单独标签；官方产物 v0.1.7-ultra-beta2 / -to20s 都不动。
# 基座默认用 -to20s（本机生产形态必需的那层 20s GPU 探测超时），保持与现役容器一致。
#
# 构建上下文（由 docker/build.sh 自动组装，也可手工准备）必须含：
#   install-pcieipc.sh  gate-check-v3.py  manifest.txt  obligations.txt
#   newfiles/  append/
# 其中 newfiles/append/manifest/obligations 由 extract-pcieipc.py 从 wheel 生成（同名脚本在本目录）。
#
# RUN 里跑的是完整安装链（幂等门 -> pre 门禁 -> 落文件 -> 追加 -> py_compile -> post 门禁 -> import 门禁）。
# import 门禁**硬开**：已实测基座镜像在无 GPU 的 build 环境里 `import flashinfer.comm` 可用（4.6s，
# hasattr=False 正好是本次要补的缺口），所以这里不需要 skip-import-gate 退路。

ARG BASE_IMAGE=vllm-sm75:v0.1.7-ultra-beta2-to20s
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG SM75_SOURCE_WHEEL=flashinfer_python-0.7.0.post1-py3-none-any.whl
LABEL sm75.t11a.component="flashinfer-pcie-ipc-backport" \
      sm75.t11a.base="${BASE_IMAGE}" \
      sm75.t11a.source_wheel="${SM75_SOURCE_WHEEL}" \
      sm75.t11a.source_wheel_sha256="c7adf826568d61fc1b7d3aadd4cae387a35a138bfc08e2deca2f34ecfa280716" \
      sm75.t11a.files_added="6" \
      sm75.t11a.files_appended="3" \
      sm75.t11a.scope="flashinfer only; vllm tree untouched" \
      sm75.t11a.upstream="FlashInfer (Apache-2.0) — 本层文件逐字来自 0.7.0.post1，见 NOTICE"

COPY install-pcieipc.sh gate-check-v3.py manifest.txt obligations.txt /tmp/pcieipc/
COPY newfiles/ /tmp/pcieipc/newfiles/
COPY append/ /tmp/pcieipc/append/

RUN sh /tmp/pcieipc/install-pcieipc.sh /tmp/pcieipc && rm -rf /tmp/pcieipc
